{
  "name": "@nimoxie/dsh-model-organizer",
  "version": "0.5.12",
  "description": "DSH 模型整理插件：输入框模型菜单按供应商分组并可拖拽排序；接管设置里的「模型」页——直接编辑供应商与模型、获取可用模型、添加/删除路由。",
  "type": "module",
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "model-selector",
    "reasoning-effort",
    "drag-and-drop"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "NimoXie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimoXie15/dsh-model-organizer.git"
  },
  "homepage": "https://github.com/NimoXie15/dsh-model-organizer#readme",
  "bugs": {
    "url": "https://github.com/NimoXie15/dsh-model-organizer/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
